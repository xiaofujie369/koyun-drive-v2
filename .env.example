# Copy to .env (install.sh generates this for you with random secrets).
APP_NAME="Koyun Drive"
APP_ENV=production
# base64:<32 random bytes>
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
# public site address (used in share / direct links)
APP_URL=https://pan.example.com
APP_LOCALE=zh_CN
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=koyun_drive
DB_USERNAME=drive
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_PREFIX=koyun_drive_

SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_COOKIE=koyun_drive_session
# false only when serving plain http
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
CACHE_PREFIX=koyun_drive_cache_
QUEUE_CONNECTION=sync

OCTANE_SERVER=swoole
OCTANE_WORKERS=4
OCTANE_HTTPS=true

DRIVE_FILES_PATH=/app/storage/drive/files
DRIVE_TMP_PATH=/app/storage/drive/tmp
# Optional dedicated upload domain that bypasses CDN body-size limits (e.g. Cloudflare grey cloud).
DRIVE_UPLOAD_URL=
DRIVE_CORS_ORIGINS=https://pan.example.com

# docker-compose
IMAGE_TAG=latest
WEB_BIND=127.0.0.1:8096
